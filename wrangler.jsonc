{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thethomasbachmann-com",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  // Statische Dateien aus ./public werden direkt ausgeliefert.
  // Alles, was dort nicht existiert (z. B. /linktree), landet im Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "observability": { "enabled": true },

  // Worker-Routen auf der Cloudflare-Zone. Die bestehenden (proxied) DNS-Einträge
  // bleiben unverändert – MX/SPF für die E-Mail bei webgo sind davon nicht betroffen.
  "routes": [
    { "pattern": "thethomasbachmann.com/*", "zone_name": "thethomasbachmann.com" },
    { "pattern": "www.thethomasbachmann.com/*", "zone_name": "thethomasbachmann.com" }
  ]
}
